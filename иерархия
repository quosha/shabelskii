package zoo.zoo;

import zoo.enclosures.Enclosure;
import zoo.staff.Employee;

import java.util.List;

public class Zoo {
    private List<Enclosure> enclosures;
    private List<Employee> employees;

    public Zoo(List<Enclosure> enclosures, List<Employee> employees) {
        this.enclosures = enclosures;
        this.employees = employees;
    }

    public void open() {
        System.out.println("Зоопарк открыт");
        employees.forEach(Employee::work);
    }
}

